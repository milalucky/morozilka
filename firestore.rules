rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function member() {
      return verified() && request.auth.token.email in get(/databases/$(database)/documents/settings/access).data.emails;
    }
    // Provision this document in the Firebase Console. Clients cannot grant access.
    match /settings/access {
      allow get: if verified() && request.auth.token.email in resource.data.emails;
      allow list, write: if false;
    }
    match /freezers/home {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasAll(['schemaVersion','createdAt','initialImportComplete'])
        && request.resource.data.keys().hasOnly(['schemaVersion','createdAt','initialImportComplete'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.initialImportComplete == false;
      allow update: if member()
        && resource.data.initialImportComplete == false
        && request.resource.data.initialImportComplete == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['initialImportComplete']);

      match /categories/{categoryId} {
        function validCategory() {
          let d = request.resource.data;
          return d.keys().hasAll(['name','color','order']) && d.keys().hasOnly(['name','color','order'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 40
            && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
            && d.order is int && d.order >= 0;
        }
        allow read: if member();
        allow create: if member() && validCategory();
      }
      match /products/{productId} {
        function validProduct() {
          let d = request.resource.data;
          return d.keys().hasAll(['name','category','weight','weightUnit','quantity','quantityUnit','note','uncertain','revision','updatedAt'])
            && d.keys().hasOnly(['name','category','weight','weightUnit','quantity','quantityUnit','note','uncertain','revision','updatedAt'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 180
            && d.category is string && d.category.size() > 0 && d.category.size() <= 400
            && existsAfter(/databases/$(database)/documents/freezers/home/categories/$(d.category))
            && (d.weight == null || (d.weight is number && d.weight > 0 && d.weight <= 1000000))
            && d.weightUnit in ['г','кг']
            && (d.quantity == null || (d.quantity is int && d.quantity > 0 && d.quantity <= 1000000))
            && d.quantityUnit in ['шт','уп'] && (d.weight != null || d.quantity != null)
            && d.note is string && d.note.size() <= 500 && d.uncertain is bool
            && d.revision is int && d.updatedAt == request.time;
        }
        allow read: if member();
        allow create: if member() && validProduct() && request.resource.data.revision == 1;
        allow update: if member() && validProduct() && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if member();
      }
    }
  }
}